<?xml version="1.0" encoding="utf-8"?>
<view xmlns:android="http://schemas.android.com/apk/res/android"
    class="com.abdullaherturk.duopanel.OverlayService$StripLayout"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_glass_r22" android:orientation="vertical">
    <LinearLayout android:id="@+id/drawer_header" android:layout_width="match_parent"
        android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="12dp"
        android:clickable="true" android:focusable="true" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/set_strip" android:textStyle="bold" android:textColor="?attr/dpText" />
        <TextView android:id="@+id/drawer_close" android:layout_width="48dp" android:layout_height="48dp"
            android:text="×" android:textSize="26sp" android:gravity="center" android:textColor="?attr/dpAccent"
            android:contentDescription="@string/strip_close" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <ScrollView android:id="@+id/drawer_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal" android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center">
    <FrameLayout
        android:id="@+id/btn_left"
        android:layout_width="72dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_glass_r14"
        android:clickable="true"
        android:contentDescription="@string/all_apps_left"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_left"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:layout_gravity="start|center_vertical" />
        <TextView
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center"
            android:drawableTop="@drawable/ic_apps"
            android:text="@string/slot_left"
            android:textSize="10sp"
            android:textColor="?attr/dpAccent" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btn_right"
        android:layout_width="72dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_glass_r14"
        android:clickable="true"
        android:contentDescription="@string/all_apps_right"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_right"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:layout_gravity="start|center_vertical" />
        <TextView
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center"
            android:drawableTop="@drawable/ic_apps"
            android:text="@string/slot_right"
            android:textSize="10sp"
            android:textColor="?attr/dpAccent" />
    </FrameLayout>

            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center">
                <TextView android:id="@+id/btn_ratio" android:layout_width="80dp" android:layout_height="48dp"
                    android:background="@drawable/bg_pill_glass" android:contentDescription="@string/ratio_label"
                    android:gravity="center" android:textColor="?attr/dpAccent" android:textStyle="bold"
                    android:clickable="true" android:focusable="true" />
                <ImageView android:id="@+id/btn_swap" android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_marginStart="12dp" android:background="@drawable/bg_pill_glass"
                    android:contentDescription="@string/strip_swap_desc" android:padding="10dp"
                    android:src="@drawable/ic_swap" android:tint="?attr/dpAccent" android:clickable="true" android:focusable="true" />
            </LinearLayout>
            <TextView android:id="@+id/tv_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="36sp" android:textStyle="bold" android:textColor="?attr/dpText" />
            <TextView android:id="@+id/tv_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textColor="?attr/dpText" />
            <TextView android:id="@+id/tv_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="?attr/dpMuted" />
            <LinearLayout android:id="@+id/wx_container" android:layout_width="match_parent" android:layout_height="64dp"
                android:orientation="horizontal" android:gravity="center" android:focusable="true"
                android:background="@drawable/bg_pill_glass" android:layout_marginTop="12dp">
                <ImageView android:id="@+id/iv_weather" android:layout_width="32dp" android:layout_height="32dp"
                    android:src="@drawable/ic_wx_sun" />
                <TextView android:id="@+id/tv_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--°" android:textSize="24sp" android:textColor="?attr/dpText" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                android:orientation="horizontal" android:gravity="center">
                <View android:id="@+id/dot_gps" android:layout_width="8dp" android:layout_height="8dp"
                    android:layout_marginEnd="8dp" android:background="@drawable/bg_dot_off" />
                <TextView android:id="@+id/tv_speed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--" android:textSize="28sp" android:textColor="?attr/dpText" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:text="@string/speed_unit" android:textColor="?attr/dpMuted" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center">
                <ImageView android:id="@+id/iv_compass" android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_compass" android:tint="?attr/dpAccent" />
                <TextView android:id="@+id/tv_dir" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:text="--" android:textSize="20sp" android:textColor="?attr/dpText" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</view>
